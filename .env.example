# Copy to .env.local and fill in. Only the Supabase pair is required.

# --- Supabase (required) ---------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest location (used by scripts/ingest/run.ts and the GitHub Action) --
# Defaults to Midtown Manhattan when unset.
INGEST_ADDRESS="New York, NY"
INGEST_POSTAL_CODE=10001
INGEST_LAT=40.7484
INGEST_LNG=-73.9857
INGEST_RADIUS_MILES=2
# Whole Foods store id: npx tsx scripts/wf-find-store.ts <store-page-slug>
INGEST_WF_STORE_ID=

# --- Optional: Gemini (Fairway flyer prices + dinner ideas) -----------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Optional: push alerts for watched items --------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY; exposed to the browser for subscribing
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Optional: in-app "Refresh now" button -----------------------------------
# Fine-grained PAT with Actions: read & write on this repo
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=your-user/deal-radar
